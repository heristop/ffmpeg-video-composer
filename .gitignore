.DS_Store
.vscode/
.idea/
build
# Gradle's local build cache (checksums, file hashes, daemon state). Trailing slash so it
# only ever matches the directory — the tracked build.gradle scripts are unaffected.
.gradle/
# @leclap/cli demo-clip + media download cache (any `assets/` dir), except the apps'
# own asset directories (e.g. apps/leclap-expo/assets), which are tracked.
assets/
!apps/**/assets/
coverage
node_modules
dist
.env
.playwright-mcp
test-results
playwright-report

# local smoke-test / preview screenshots
*-smoke.png
form-banner-*.png

# the agentic PR example's recordings (its README and demo-shop/record.mjs write them here)
examples/agentic-pr-video/evidence/

# local Claude Code state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Curated media + fonts are committed once in
# packages/creative-kit/src/library/ (the single source of truth).
# scripts/copy-core-assets.ts copies them into each app's static dir on dev/build,
# so the generated copies are not tracked.
/apps/leclap-web/public/musics/
/apps/leclap-web/public/backgrounds/
/apps/leclap-web/public/fonts/
/apps/leclap-web/public/assets/
# The ffmpeg.wasm core, staged from @ffmpeg/core on dev/build by apps/leclap-web/scripts/stage-ffmpeg-core.ts.
/apps/leclap-web/public/ffmpeg-core/
/apps/leclap-web/public/html-engine/
/apps/leclap-expo/assets/animations/
/apps/leclap-expo/assets/animation-thumbs/
/apps/leclap-expo/assets/musics/
/apps/leclap-expo/assets/backgrounds/
/apps/leclap-expo/assets/covers/
/apps/leclap-expo/assets/fonts/
/apps/leclap-expo/assets/emoji/
/apps/leclap-expo/assets/videos/
# the engine's HTML layer page (packages/ffmpeg-video-composer/dist/html-rasteriser.html)
/apps/leclap-expo/assets/html-rasteriser/
# keep the Expo app's own (non-library) font tracked
!/apps/leclap-expo/assets/fonts/SpaceMono-Regular.ttf
# server template JSONs copied from packages/server-app/templates by the same script
/apps/leclap-expo/src/templates/server/

# On-device FFmpeg engine — generated build artifacts (regenerable from source;
# see scripts/ffmpeg/*.sh and packages/ffmpeg-engine/). dist/ + target/ already match above.
/scripts/ffmpeg/.work/
/scripts/ffmpeg/deps/
/packages/ffmpeg-engine/target-host/
/packages/ffmpeg-engine/*.o

# Engine binaries staged into the Expo module — never committed; rebuild with
# scripts/ffmpeg/build-engine.sh (see docs/on-device-compilation.md).
apps/leclap-expo/modules/leclap-ffmpeg/android/src/main/jniLibs/
apps/leclap-expo/modules/leclap-ffmpeg/ios/libleclap_ffmpeg_core.a
apps/leclap-expo/modules/leclap-ffmpeg/ios/LeclapFfmpegCore.xcframework/

# Brainstorming/plan docs kept locally only, never tracked.
docs/superpowers/


# Local dependency store and implementation coordination artifacts.
.pnpm-store/
.superpowers/

# Python bytecode and vitest JSON reports.
__pycache__/
.vitest/
