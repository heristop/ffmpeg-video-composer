          }
        }
      ]
    },
    {
      "type": "partial",
      "ref": "flash-card",
      "prefix": "q3_",
      "variables": {
        "optionA": "{{ optionA3 }}",
        "optionB": "{{ optionB3 }}"
      }
    },
    {
      "name": "video_3",
      "type": "project_video",
      "look": "vivid-pop",
      "title": {
        "en": "Answer #3"
      },
      "description": {
        "en": "{{ optionA3 }} or {{ optionB3 }}? — film your answer"
      },
      "options": {
        "duration": 12,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "musicVolume": 0.04
      },
      "filters": [
        {
          "type": "vignette"
        },
        {
          "type": "drawbox",
          "values": {
            "x": 0,
            "y": 600,
            "w": 1280,
            "h": 120,
            "c": "#141416@0.55",
            "t": "fill"
          }
        },
        {
          "type": "drawbox",
          "values": {
            "x": 80,
            "y": 628,
            "w": 90,
            "h": 5,
