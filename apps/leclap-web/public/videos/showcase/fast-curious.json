            "c": "#141416@0.55",
            "t": "fill"
          }
        },
        {
          "type": "drawbox",
          "values": {
            "x": 80,
            "y": 628,
            "w": 90,
            "h": 5,
            "c": "#ff2e4d@1",
            "t": "fill"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ optionA2 }} or {{ optionB2 }}?"
            },
            "fontcolor": "#f5f5f0",
            "fontsize": 44,
            "x": 80,
