{
  "meta": {
    "name": "Fast & Curious",
    "description": "Punchy two-tone flash intro — your name on a bold cut, then your clip."
  },
  "global": {
    "variables": {
      "optionA1": "Tea",
      "optionB1": "Coffee",
      "optionA2": "Beach",
      "optionB2": "Mountains",
      "optionA3": "Cats",
      "optionB3": "Dogs"
    },
    "orientation": "landscape",
    "musicEnabled": true,
    "music": {
      "name": "future-bass-energy.mp3"
    },
    "allowedMusic": ["future-bass-energy", "upbeat-electronic", "lofi-hip-hop", "party-dance", "indie-rock-dreamy"],
    "allowUploadMusic": true,
    "transition": {
      "type": "fade",
      "duration": 0.2
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "normalize": "loudnorm",
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "intro",
      "type": "color_background",
      "transition": {
        "type": "fade",
        "duration": 0.4
      },
      "titleCard": {
        "kicker": {
          "en": "FAST & CURIOUS"
        },
        "headline": {
          "en": "Meet {{ form_1_firstname }}"
        },
        "subtitle": {
          "en": "this or that — in 60 seconds"
        },
        "accent": "#ff2e4d",
        "reveal": "rise",
        "effect": {
          "shadow": true,
          "outline": true
        }
      },
      "options": {
        "backgroundColor": "#141416",
        "duration": 3.5
      }
    },
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Who's the star?"
      },
      "description": {
        "en": ""
      },
      "options": {
        "fields": [
          {
            "name": "form_1_firstname",
            "maxLength": 20,
            "label": {
              "en": "First name"
            }
          }
        ]
      }
    },
    {
      "type": "partial",
      "ref": "flash-card",
      "prefix": "q1_",
      "variables": {
        "optionA": "{{ optionA1 }}",
        "optionB": "{{ optionB1 }}"
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "vivid-pop",
      "title": {
        "en": "Answer #1"
      },
      "description": {
        "en": "{{ optionA1 }} or {{ optionB1 }}? — film your answer"
      },
      "options": {
        "duration": 12,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "musicVolume": 0.04
      },
      "filters": [
        {
          "type": "vignette"
        },
        {
          "type": "drawbox",
          "values": {
            "x": 0,
            "y": 600,
            "w": 1280,
            "h": 120,
            "c": "#141416@0.55",
            "t": "fill"
          }
        },
        {
          "type": "drawbox",
          "values": {
            "x": 80,
            "y": 628,
            "w": 90,
            "h": 5,
            "c": "#ff2e4d@1",
            "t": "fill"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ optionA1 }} or {{ optionB1 }}?"
            },
            "fontcolor": "#f5f5f0",
            "fontsize": 44,
            "x": 80,
            "y": 644,
            "fontfile": "BebasNeue.ttf"
          }
        },
        {
          "type": "fadein",
          "values": {
            "color": "#141416"
          }
        },
        {
          "type": "fadeout",
          "values": {
            "color": "#141416"
          }
        }
      ]
    },
    {
      "type": "partial",
      "ref": "flash-card",
      "prefix": "q2_",
      "variables": {
        "optionA": "{{ optionA2 }}",
        "optionB": "{{ optionB2 }}"
      }
    },
