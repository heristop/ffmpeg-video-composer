      "inputs": [
        {
          "name": "next_step",
          "type": "html",
          "html": "<div class=\"row\"><span class=\"num\">02</span><span class=\"text\">Try it in your app</span></div>",
          "css": ".row { display: flex; align-items: center; gap: 20px; height: 100% } .num { display: flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 18px; background: $color.fg; color: $color.bg; font: 44px $font.display; letter-spacing: 1px } .text { padding: 10px 22px; border-radius: 999px; border: 2px solid $color.muted@0.6; color: $color.fg; font: 500 30px $font.body; text-transform: uppercase; letter-spacing: 2px }",
          "width": 700,
          "height": 96,
          "options": {
            "position": "64:784",
            "start": 0.24,
            "motion": {
              "type": "slide-right",
              "delay": 0.24,
              "duration": 0.26,
