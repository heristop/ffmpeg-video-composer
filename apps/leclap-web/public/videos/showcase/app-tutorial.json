      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "YOUR TURN"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 110,
            "fontcolor": "#172c25",
            "x": 64,
            "y": 250
