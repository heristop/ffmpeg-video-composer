{
  "meta": {
    "name": "App Tutorial",
    "description": "A screen-first square lesson with numbered steps, calm mint typography and a letterboxed walkthrough.",
    "creativeDirection": "Audience: a new user learning one interaction. Direction: calm, screen-first instruction in a square frame. Use pale mint surfaces and numbered steps; let the walkthrough carry the explanation. Keep caption hierarchy subordinate to the interface and preserve the recorded cursor and controls within the letterboxed screen. Stagger the numbered instruction with short, restrained directional entrances and enough time to understand each action. Avoid promotional camera moves, bouncing labels, tiny interface details and decorative interruptions. Review the step number, interaction visibility, caption placement, longest copy and final instruction. Motion: a rule that draws and settles under the topic, calm pushes between steps, then one tap after the closing step; no camera over the interface."
  },
  "global": {
    "orientation": "square",
    "musicEnabled": true,
    "music": {
      "name": "the-builder.mp3"
    },
    "allowedMusic": ["the-builder", "lofi-hip-hop", "point-being", "lofi-study", "lofi-chill"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.28,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    },
    "theme": {
      "colors": {
        "bg": "#edf4ed",
        "fg": "#172c25",
        "muted": "#436354",
        "surface": "#c8e4d7"
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your tutorial"
      },
      "description": {
        "en": "What you're teaching and the step shown over your screen recording"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_topic",
            "maxLength": 20,
            "label": {
              "en": "What you'll show"
            }
          },
          {
            "name": "form_1_step",
            "maxLength": 38,
            "label": {
              "en": "Step caption"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#edf4ed",
        "duration": 1.8,
        "layers": [
          {
            "color": "#172c25",
            "x": 64,
            "y": 280,
            "w": 952,
            "h": 3
          }
        ]
      },
      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_topic }}"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 76,
            "fontcolor": "#172c25",
            "x": 64,
            "y": 350
          },
          "reveal": {
            "type": "rise",
            "delay": 0.13,
            "duration": 0.32,
            "distance": 24,
            "easing": "ease-out"
          },
          "exit": {
            "type": "rise",
            "after": 1.56,
            "duration": 0.2,
            "easing": "ease-out",
            "distance": 18
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "WATCH. THEN TRY."
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 30,
            "fontcolor": "#436354",
            "x": 64,
            "y": 690
          },
          "reveal": {
            "type": "fade",
            "delay": 0.24,
            "duration": 0.2,
            "easing": "ease-out"
          },
          "exit": {
            "type": "fade",
            "after": 1.59,
            "duration": 0.17,
            "easing": "ease-out"
          }
        }
      ],
      "transition": {
        "type": "push-left",
        "duration": 0.5,
        "ease": "$smooth"
      },
      "graphics": [
        {
          "type": "underline",
          "x": 64,
          "y": 448,
          "width": 300,
          "thickness": 6,
          "at": 0.6,
          "color": "$color.muted",
          "caps": "round",
          "settle": 0.03,
          "exit": "fade",
          "exitDuration": 0.17,
          "until": 1.78
        }
      ],
      "inputs": [
        {
          "name": "lesson_badge",
          "type": "html",
          "html": "<div class=\"row\"><span class=\"num\">01</span><div class=\"col\"><span class=\"kicker\">Quick lesson</span><span class=\"of\">Step 1 of 2</span></div></div>",
          "css": ".row { display: flex; align-items: center; gap: 24px; height: 100% } .num { display: flex; align-items: center; justify-content: center; width: 120px; height: 120px; border-radius: 30px; background: $color.fg; color: $color.bg; font: 67px $font.display; letter-spacing: 1px } .col { display: flex; flex-direction: column; gap: 6px } .kicker { padding: 6px 16px; border-radius: 999px; background: $color.surface; color: $color.fg; font: 500 26px $font.body; text-transform: uppercase; letter-spacing: 2px } .of { padding-left: 4px; color: $color.muted; font: 400 22px $font.body }",
          "width": 640,
          "height": 140,
          "options": {
            "position": "64:54",
            "start": 0.04,
            "motion": {
              "type": "slide-right",
              "delay": 0.04,
              "duration": 0.3,
              "distance": 14,
              "easing": "ease-out"
            }
          }
        }
      ]
    },
    {
      "name": "video_1",
      "type": "project_video",
      "title": {
        "en": "Record your screen"
      },
      "description": {
        "en": "Upload or record a screen walkthrough. The full frame is preserved and the step caption appears at the bottom."
      },
      "options": {
        "duration": 10,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "forceOriginalAspectRatio": true
      },
      "transition": {
        "type": "push-left",
        "duration": 0.5,
        "ease": "$smooth"
      },
      "inputs": [
        {
          "name": "step_card",
          "type": "html",
          "html": "<div class=\"wrap\"><div class=\"card\"><span class=\"num\">01</span><span class=\"text\">{{ form_1_step }}</span></div></div>",
          "css": ".wrap { display: flex; align-items: flex-end; height: 100% } .card { display: flex; align-items: center; gap: 20px; padding: 12px 30px 12px 12px; border-radius: 22px; background: $color.fg@0.94 } .num { display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background: $color.surface; color: $color.fg; font: 40px $font.display; letter-spacing: 1px } .text { color: $color.bg; font: 400 34px $font.body }",
          "width": 952,
          "height": 100,
          "options": {
            "position": "64:910",
            "start": 0.15,
            "motion": {
              "type": "slide-right",
              "delay": 0.15,
              "duration": 0.24,
              "distance": 24,
              "easing": "ease-out"
            }
          }
        }
      ]
    },
