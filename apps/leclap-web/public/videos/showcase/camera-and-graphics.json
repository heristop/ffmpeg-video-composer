{
  "meta": {
    "name": "Camera and graphics",
    "description": "Motion system effects: designed transitions, a virtual camera with hits and shake, and animated graphics.",
    "creativeDirection": "Audience: creators who want a trailer feel from JSON alone. Direction: each beat has one camera idea and one graphic idea. A punch beat (impact type, camera hits, a flash on the downbeat, viewfinder corners), a slow dolly with a tracing frame and an underline, a cinema beat with bars and a handheld drift, a colour wipe that turns the page, and a calm close. Transitions are designed, not stock: push on a spring, zoom-through, iris, swipe. Review: no edge ever shows during camera moves, flashes never exceed three per second, text stays readable at every hit, every transition settles before the next beat's first entrance."
  },
  "global": {
    "orientation": "landscape",
    "fps": 30,
    "musicEnabled": false,
    "seed": 5,
    "motion": {
      "energy": 1
    }
  },
  "sections": [
    {
      "name": "punch",
      "type": "color_background",
      "options": {
        "backgroundColor": "#141416",
        "duration": 2.4
      },
      "camera": {
        "hits": [
          0.3,
          {
            "at": 1.2,
            "strength": 0.06
          }
        ]
      },
      "graphics": [
        {
          "type": "flash",
          "at": 0.3,
          "duration": 0.25
        },
        {
          "type": "corners",
          "at": 0.5,
          "color": "#FF8AAE"
        }
      ],
      "kinetic": [
        {
          "text": {
            "en": "DROP."
          },
          "preset": "impact",
          "size": 260,
          "delay": 0.2,
          "color": "#F5F3F7"
        }
      ],
      "transition": {
        "type": "push-left",
        "duration": 0.6,
        "ease": "$snappy"
