{
  "meta": {
    "name": "Interview",
    "description": "An 'on the record' name card, then your answer with a branded lower-third name and title."
  },
  "global": {
    "orientation": "landscape",
    "musicEnabled": true,
    "music": {
      "name": "lofi-sentimental-jazz.mp3"
    },
    "allowedMusic": ["lofi-sentimental-jazz", "cafe-jazz", "lofi-chill", "lofi-cafe", "dreamy-fall-people"],
    "allowUploadMusic": true,
    "transition": {
      "type": "fade",
      "duration": 0.5
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "normalize": "loudnorm",
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Who's on camera?"
      },
      "description": {
        "en": ""
      },
      "options": {
        "fields": [
          {
            "name": "form_1_name",
            "maxLength": 24,
            "label": {
              "en": "Name"
            }
          },
          {
            "name": "form_1_title",
            "maxLength": 32,
            "label": {
              "en": "Title / role"
            }
          },
          {
            "name": "form_1_question",
            "maxLength": 48,
            "label": {
              "en": "Question to answer"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "transition": {
        "type": "zoom-through",
        "duration": 0.5
      },
      "options": {
        "backgroundColor": "#0d1b2a",
        "duration": 2.6
      },
      "filters": [
        {
          "type": "drawbox",
          "values": {
            "x": 0,
            "y": 0,
            "w": 1280,
            "h": 720,
            "c": "#0d1b2a@1",
            "t": "fill"
          }
        },
        {
          "type": "drawbox",
          "values": {
            "x": 0,
            "y": 0,
            "w": 1280,
            "h": 150,
            "c": "#13243f@1",
            "t": "fill"
          }
        },
        {
          "type": "drawbox",
          "values": {
            "x": 0,
            "y": 570,
            "w": 1280,
            "h": 150,
            "c": "#13243f@1",
            "t": "fill"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "ON THE RECORD"
            },
            "fontcolor": "#9aa7c7",
            "fontsize": 30,
            "x": "(w-text_w)/2",
            "y": 232,
            "fontfile": "Oswald.ttf",
            "alpha": "'if(lt(t,0.3),0,if(lt(t,1.0),(t-0.3)/0.7,1))'"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_name }}"
            },
            "fontcolor": "#7C83FD",
            "fontsize": 112,
            "x": "(w-text_w)/2",
            "y": 300,
            "fontfile": "BebasNeue.ttf",
            "alpha": "'if(lt(t,0.6),0,if(lt(t,1.5),(t-0.6)/0.9,1))'"
          }
        },
        {
          "type": "drawbox",
          "values": {
            "x": 540,
            "y": 446,
            "w": 200,
            "h": 4,
            "c": "#7C83FD@1",
            "t": "fill"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_title }}"
            },
            "fontcolor": "#e8eef7",
            "fontsize": 34,
            "x": "(w-text_w)/2",
            "y": 470,
            "fontfile": "Oswald.ttf",
            "alpha": "'if(lt(t,1.0),0,if(lt(t,1.8),(t-1.0)/0.8,1))'"
          }
        },
        {
          "type": "vignette"
        },
        {
          "type": "fade",
          "values": {
            "t": "in",
            "d": "0.6",
            "color": "#0d1b2a"
          }
        },
        {
          "type": "fade",
          "values": {
            "t": "out",
            "d": "{{ transitionDuration }}",
            "st": "{{ transitionStartTime }}",
            "color": "#0d1b2a"
          }
        }
      ]
    },
    {
      "name": "question",
      "type": "color_background",
      "transition": {
        "type": "swipe-left",
        "duration": 0.5
      },
      "titleCard": {
        "kicker": {
          "en": "QUESTION"
        },
        "headline": {
          "en": "{{ form_1_question }}"
        },
        "subtitle": {
          "en": "{{ form_1_name }} · {{ form_1_title }}"
        },
        "headlineStyle": {
          "font": "Oswald.ttf",
          "fontsize": 46
        },
        "accent": "#7C83FD",
        "align": "center",
        "reveal": "rise",
        "effect": {
          "shadow": true
        }
      },
      "options": {
        "backgroundColor": "#0d1b2a",
        "duration": 3.2
      },
      "filters": [
        {
          "type": "vignette"
        }
      ]
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "teal-orange",
      "grade": {
        "colorBalance": {
          "shadows": {
            "b": 0.05
          },
          "highlights": {
            "r": 0.04
          }
        }
      },
      "title": {
        "en": "Answer the question"
      },
      "description": {
        "en": "Look at the camera and answer — your name sits in the lower-third"
      },
      "options": {
        "duration": 15,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "musicVolume": 0.04,
        "framingGuide": {
          "type": "silhouette",
          "position": "center"
        }
      },
      "filters": [
        {
          "type": "vignette"
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_question }}"
            },
            "fontcolor": "#f5f5f0",
            "fontsize": 38,
            "x": "(w-text_w)/2",
            "y": 64,
            "fontfile": "Oswald.ttf",
            "bordercolor": "#0d1b2a",
            "borderw": 3,
            "alpha": "'if(lt(t,0.5),0,if(lt(t,1.2),(t-0.5)/0.7,if(lt(t,5.0),1,if(lt(t,5.9),1-(t-5.0)/0.9,0))))'"
          }
        },
        {
          "type": "fadein",
          "values": {
            "color": "#0d1b2a"
          }
        },
        {
          "type": "fadeout",
          "values": {
            "color": "#0d1b2a"
          }
        }
      ],
      "graphics": [
        {
          "type": "corners",
          "at": 0.6,
          "until": 14.4,
          "above": true,
          "target": {
            "x": 40,
            "y": 40,
            "w": 1200,
            "h": 502
          },
          "clearance": 0,
          "length": 64,
          "thickness": 4,
          "color": "#F5F3F7",
          "contrast": "shadow",
          "spread": 1.04,
          "trace": "clockwise",
          "exit": "expand"
        }
      ],
      "inputs": [
        {
          "name": "name_card",
          "type": "html",
          "html": "<div class=\"wrap\"><div class=\"card\"><div class=\"top\"><h2>{{ form_1_name }}</h2><span class=\"badge\">On the record</span></div><p>{{ form_1_title }}</p></div></div>",
          "css": ".wrap { display: flex; align-items: flex-end; height: 100%; padding: 0 16px 16px 0 } .card { display: flex; flex-direction: column; padding: 16px 28px 18px 24px; border-left: 8px solid $color.brand; border-radius: 0 14px 14px 0; background: $color.bg@0.9; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35) } .top { display: flex; align-items: center; gap: 16px } h2 { margin: 0; color: $color.fg; font: 500 50px $font.body; line-height: 1.1 } .badge { padding: 6px 14px; border-radius: 999px; background: $color.brand; color: $color.bg; font: 600 17px $font.body; text-transform: uppercase; letter-spacing: 2px } p { margin: 2px 0 0; color: $color.muted; font: 400 26px $font.body }",
          "width": 860,
          "height": 150,
          "options": {
            "position": "0:540",
            "start": 0.6,
            "motion": {
              "type": "slide-right",
              "delay": 0.6,
              "duration": 0.6,
              "distance": 80,
              "easing": "ease-out"
            }
          }
        }
      ]
    },
    {
      "type": "partial",
      "ref": "logo-bumper"
    }
  ],
  "partials": [
    {
      "id": "logo-bumper",
      "description": "LeClap logo sting (landscape): the 2.4 s bumper clip framed by brand-coloured rules, faded in and out.",
      "envelope": {
        "in": 0.5,
        "out": 0.5
      },
      "syncPoints": [
        {
          "id": "logo",
          "offset": 0.5
        }
      ],
      "jobs": ["brand", "close"],
      "useWhen": "Open or sign off a video with the LeClap identity, ideally with the logo landing on a downbeat.",
      "avoidWhen": "Mid-video: a bumper reads as a beginning or an ending, never as a transition.",
      "sections": [
        {
          "name": "logo_bumper",
          "type": "video",
          "options": {
            "videoUrl": "https://github.com/heristop/leclap/raw/main/src/shared/assets/videos/leclap_bumper.mp4",
            "duration": 2.4,
            "muteSection": true
          },
          "filters": [
            {
              "type": "drawbox",
              "values": {
                "x": 0,
                "y": 0,
                "w": 1280,
                "h": 10,
                "c": "#7C83FD@1",
                "t": "fill"
              }
            },
            {
              "type": "drawbox",
              "values": {
                "x": 0,
                "y": 710,
                "w": 1280,
                "h": 10,
                "c": "#FF8AAE@1",
                "t": "fill"
              }
            },
            {
              "type": "fadein",
              "values": {
                "color": "#0b0b0f"
              }
            },
            {
              "type": "fadeout",
              "values": {
                "color": "#0b0b0f"
              }
            }
          ]
        }
      ]
    }
  ]
}
