{
  "meta": {
    "name": "Motion FX pack",
    "description": "Motion effects pack: kinetic echo trails, whip transitions, glitch and focus hits, data and broadcast graphics (progress, ticker, bar chart) and lower-third styles. Asset-free.",
    "creativeDirection": "Audience: creators who want broadcast and social polish from JSON alone. Direction: a glitched hook whose punch word smears in, a rack-focus title, a data beat where bars grow and count up under a progress bar, a ticker beat, and a close that shows the lower-third styles. Whips carry the energy between beats. Review: the glitch never lasts longer than a beat, echoes vanish once the word lands, every number is readable once it settles, the ticker loops cleanly, and lower thirds stay inside the title-safe area."
  },
  "global": {
    "orientation": "landscape",
    "fps": 30,
    "musicEnabled": false,
    "seed": 11,
    "motion": {
      "energy": 1
    }
  },
  "sections": [
