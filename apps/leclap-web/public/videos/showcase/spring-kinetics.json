{
  "meta": {
    "name": "Spring kinetics",
    "description": "Motion system study: springs, brand curves, motion tokens, keyframe tracks and the energy dial.",
    "creativeDirection": "Audience: people who judge motion by feel. Direction: physical, confident, never floaty. The headline lands on a spring and its scale settles a beat later; the support line follows on the brand's juicy curve; the counterpoint slides in on expo and leaves on smooth. Ink canvas, white Bebas Neue, lavender and pink accents. Review: overshoot stays inside the title-safe area, every word is settled for at least half a second before it leaves, and the final hold reads cleanly."
  },
  "global": {
    "orientation": "landscape",
    "fps": 30,
    "musicEnabled": false,
    "seed": 7,
    "transition": {
      "type": "cut"
    },
    "motion": {
      "energy": 1,
      "springs": {
        "land": {
          "stiffness": 260,
          "damping": 17
        }
      },
      "curves": {
        "brand": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "durations": {
        "beat": 0.5
      }
    }
  },
  "sections": [
    {
