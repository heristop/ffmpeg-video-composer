                "ease": "$smooth"
              }
            ],
            "scale": [
              {
                "t": 0.1,
                "v": 0.86
              },
              {
                "t": "+$long",
                "v": 1,
                "ease": "$bouncy"
              }
            ]
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "NOT TIMING."
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 120,
            "fontcolor": "#B8ADFF",
            "x": 86,
            "y": 380
