{
  "meta": {
    "name": "Effects tour",
    "description": "A guided tour of the LeClap motion vocabulary in ten chapters: kinetic type, camera and graphics, transitions, captions, compositing and light (the fx primitives), themes, looks and grade, footage editing, sound and music. Each chapter is its own template (effects-tour/*.json); this one strings their renders together with chapter cards and designed transitions, over a soft lo-fi bed that steps aside for the sound and music chapters.",
    "creativeDirection": "Audience: creators and agents deciding what LeClap can do. Direction: a product demo that names every effect while it plays: ink chapter cards with a kicker, a headline and the chapter contents, a designed transition into each chapter and a whip out of it, and a small mono label naming each effect inside the chapters. Review: every card holds long enough to read, chapters run in order, every effect label is legible at 960x540, and the tour ends on a single ding."
  },
  "global": {
    "orientation": "landscape",
    "fps": 30,
    "musicEnabled": true,
    "seed": 71,
    "motion": {
      "energy": 1
    },
    "variables": {
      "leclap_mark": "pictures/leclap-mark.png",
      "opening_wall": "videos/effects-tour/opening-wall.mp4",
      "chapter_01": "videos/effects-tour/01-type.mp4",
      "chapter_02": "videos/effects-tour/02-camera-graphics.mp4",
      "chapter_03": "videos/effects-tour/03-transitions.mp4",
      "chapter_04": "videos/effects-tour/04-captions.mp4",
      "chapter_05": "videos/effects-tour/05-compositing.mp4",
      "chapter_06_leclap": "videos/effects-tour/06-theme-a-leclap.mp4",
      "chapter_06_midnight": "videos/effects-tour/06-theme-b-midnight.mp4",
      "chapter_06_editorial": "videos/effects-tour/06-theme-c-editorial.mp4",
      "chapter_06_bold": "videos/effects-tour/06-theme-d-bold.mp4",
      "chapter_06_neon": "videos/effects-tour/06-theme-e-neon.mp4",
