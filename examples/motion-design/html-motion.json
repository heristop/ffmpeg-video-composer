{
  "meta": {
    "name": "Animated HTML cards",
    "description": "A listing card and stat tiles whose elements come in one after another (motion + data-motion)."
  },
  "global": {
    "orientation": "landscape",
    "musicEnabled": false,
    "fields": {
      "status": { "type": "text", "default": "New listing", "maxLength": 24 },
      "address": { "type": "text", "default": "12 rue des Lilas", "maxLength": 40 },
      "details": { "type": "text", "default": "Lyon 3e · 92 m² · 4th floor", "maxLength": 48 },
      "rooms": { "type": "text", "default": "4", "maxLength": 6 },
      "area": { "type": "text", "default": "92 m²", "maxLength": 12 },
      "price": { "type": "text", "default": "420 k€", "maxLength": 12 }
    }
  },
  "sections": [
    {
      "name": "listing",
      "type": "color_background",
      "options": { "backgroundColor": "#101418", "duration": 5 },
      "inputs": [
        {
          "name": "listing_card",
          "type": "html",
          "html": "<div class=\"card\"><span class=\"tag\" data-motion=\"tag\">{{ status }}</span><h2 data-motion=\"line\">{{ address }}</h2><p data-motion=\"line\">{{ details }}</p><div class=\"chips\"><span class=\"chip\" data-motion=\"chip\">3 rooms</span><span class=\"chip\" data-motion=\"chip\">Balcony</span><span class=\"chip\" data-motion=\"chip\">Metro 4 min</span></div></div>",
          "css": ".card { display: flex; flex-direction: column; gap: 14px; width: 100%; height: 100%; padding: 32px 36px; border-radius: 28px; background: #f4efe6 } .tag { display: flex; align-self: flex-start; padding: 6px 16px; border-radius: 999px; background: #ff5a36; color: #ffffff; font: 600 22px Rubik; text-transform: uppercase; letter-spacing: 2px } h2 { margin: 0; color: #141416; font: 56px \"Bebas Neue\" } p { margin: 0; color: #55524c; font: 26px Rubik } .chips { display: flex; gap: 10px } .chip { padding: 8px 16px; border-radius: 12px; background: #141416; color: #f4efe6; font: 500 20px Rubik }",
          "width": 640,
          "height": 300,
          "options": { "position": "96:300", "motion": { "type": "fade", "duration": 0.3 } },
          "motion": {
            "tag": {
              "opacity": [
                { "t": 0.3, "v": 0 },
                { "t": 0.55, "v": 1 }
              ],
              "x": [
                { "t": 0.3, "v": -24 },
                { "t": 0.7, "v": 0, "ease": "ease-out-cubic" }
              ]
            },
            "line": {
              "opacity": [
                { "t": 0.5, "v": 0 },
                { "t": 0.8, "v": 1 }
              ],
              "y": [
                { "t": 0.5, "v": 28 },
                { "t": 1.1, "v": 0, "ease": "$gentle" }
              ],
              "stagger": 0.15
            },
            "chip": {
              "opacity": [
                { "t": 1.0, "v": 0 },
                { "t": 1.2, "v": 1 }
              ],
              "scale": [
                { "t": 1.0, "v": 0.6 },
                { "t": 1.4, "v": 1, "ease": "spring(300, 14)" }
              ],
              "stagger": 0.12
            }
          }
        }
      ]
    },
    {
      "name": "stats",
      "type": "color_background",
      "options": { "backgroundColor": "#0d1b2a", "duration": 4 },
      "inputs": [
        {
          "name": "stat_tiles",
          "type": "html",
          "html": "<div class=\"row\"><div class=\"stat\" data-motion=\"stat\"><strong>{{ rooms }}</strong><span>rooms</span></div><div class=\"stat\" data-motion=\"stat\"><strong>{{ area }}</strong><span>living area</span></div><div class=\"stat\" data-motion=\"stat\"><strong>{{ price }}</strong><span>asking</span></div></div>",
          "css": ".row { display: flex; gap: 20px; width: 100%; height: 100% } .stat { display: flex; flex-direction: column; justify-content: center; flex-grow: 1; padding: 24px; border-radius: 20px; background: #1b263b } strong { color: #ffffff; font: 72px \"Bebas Neue\" } span { color: #9fb3c8; font: 24px Rubik }",
          "width": 960,
          "height": 220,
          "options": { "position": "160:250" },
          "motion": {
            "stat": {
              "opacity": [
                { "t": 0.2, "v": 0 },
                { "t": 0.45, "v": 1 }
              ],
              "y": [
                { "t": 0.2, "v": 40 },
                { "t": 0.8, "v": 0, "ease": "spring(260, 20)" }
              ],
              "rotate": [
                { "t": 0.2, "v": -4 },
                { "t": 0.8, "v": 0, "ease": "ease-out-cubic" }
              ],
              "stagger": 0.14
            }
          }
        }
      ]
    }
  ]
}
