{
  "meta": {
    "name": "Effects tour: looks and grade",
    "description": "Chapter 7 of the effects tour: all seventeen look presets (filter, LUT and stylized families) on bundled photographs, a LUT look at full and reduced strength on generated footage, a hand-built grade and a user .cube LUT.",
    "creativeDirection": "A quick colour relay: the same slow push-in under each look so only the grade changes, each named in the corner and bottom-left. Then the take controls on moving footage. Review: every look reads as distinct, the name stays legible on every grade, and the reduced strength sits visibly between the untouched clip and the full grade."
  },
  "global": {
    "orientation": "landscape",
    "fps": 30,
    "musicEnabled": false,
    "seed": 59,
    "transition": {
      "type": "cut"
    },
    "motion": {
      "energy": 1
    },
    "overlays": [
      {
        "text": {
          "en": "07  LOOKS & GRADE"
        },
        "position": "top-right",
        "font": "mono",
        "size": 24,
        "color": "#C9C6D2",
        "effect": {
          "shadow": true
        }
      }
    ],
    "variables": {
      "lut": "luts/warm-print.cube"
    }
  },
