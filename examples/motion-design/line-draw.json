{
  "meta": {
    "name": "Line draw",
    "description": "The path graphic: a chart line drawing on with a dot riding its end, a ring drawn around one point, a hand-drawn swash under a title and a progress ring filling to 75 %.",
    "creativeDirection": "Audience: motion designers checking what the path graphic can do. Direction: one draw per beat on a dark ink ground, light and lavender strokes, rose for the accent, a small uppercase label naming the move. The chart line runs at constant speed along its curve with the dot locked to its end, the ring closes on the point the line passed, then everything retracts in drawing order. Review: no stepping on the stroke, the dot never leaves the line's end, the ring closes exactly, the swash lands under the title, the ring stops at three quarters."
  },
  "global": {
    "orientation": "landscape",
    "fps": 30,
    "musicEnabled": false,
    "transition": {
      "type": "cut"
    }
  },
