{
  "meta": {
    "name": "Agentic PR Evidence",
    "description": "A short, review-focused video that an agent can render from implementation evidence and attach to a pull or merge request.",
    "creativeDirection": "Audience: a pull-request reviewer. Brand: LeClap, on its ink canvas, with the lavender to pink gradient, Oswald for headlines and chips, Rubik for copy and Roboto Mono for slate data. Hierarchy: the change, then the project, then the review focus. Motion: the card fades in, its header rises, the ticket decodes, the rules draw from the left and the headline cascades; one lavender sheen marks the cut into the recording. The walkthrough plays ungraded and unobstructed, with one ink label in its bottom-left corner. Nothing moves under text that is being read. Avoid invented test results, simulated interactions and camera moves. Review: the recording, the label, the review-focus card and the closing card."
  },
  "global": {
    "orientation": "landscape",
    "variables": {
      "project": "Example project",
      "ticket": "PR #123",
      "change": "Keyboard navigation",
      "reviewFocus": "Focus order and visible focus states"
    },
    "musicEnabled": false,
    "transition": {
      "type": "fade",
      "duration": 0.35
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0
    }
  },
  "sections": [
    {
      "name": "intro",
      "type": "color_background",
      "options": {
        "duration": 3.4,
        "backgroundColor": "#141416"
      },
      "inputs": [
        {
          "name": "stage",
          "type": "html",
          "width": 1280,
          "height": 720,
          "html": "<div class=\"stage\"></div>",
          "css": ".stage { width: 1280px; height: 720px; background-image: radial-gradient(70% 60% at 50% 42%, rgba(124, 131, 253, 0.16), rgba(124, 131, 253, 0)) }",
          "options": {
            "position": "0:0"
          }
        },
        {
          "name": "card",
          "type": "html",
          "width": 960,
          "height": 384,
          "html": "<div class=\"card\"></div>",
          "css": ".card { width: 960px; height: 384px; background-color: #1d1e21; border: 2px solid #323337; border-radius: 20px }",
          "options": {
            "position": "160:192",
            "motion": {
              "type": "fade",
              "delay": 0,
              "duration": 0.3
            }
          }
        },
        {
          "name": "header",
          "type": "html",
          "width": 480,
          "height": 40,
          "html": "<div class=\"head\"><img class=\"mark\" src=\"data:image/png;base64,\" width=\"40\" height=\"40\" /><span class=\"brand\">LeClap</span><span class=\"kind\">WALKTHROUGH</span></div>",
          "css": ".head { display: flex; align-items: center; width: 480px; height: 40px; gap: 12px } .mark { width: 40px; height: 40px } .brand { font: 500 28px Oswald; line-height: 40px; color: #f7f7f8 } .kind { margin-left: 18px; font: 400 14px Roboto Mono; letter-spacing: 3px; line-height: 42px; color: #afb0b4 }",
          "options": {
            "position": "206:230",
            "start": 0.4,
            "motion": {
              "type": "rise",
              "delay": 0.4,
              "duration": 0.5,
              "distance": 10,
              "easing": "$expo"
            }
          }
        },
        {
          "name": "summary",
          "type": "html",
          "width": 864,
          "height": 40,
          "html": "<p class=\"summary\">{{ project }}, recorded on the branch under review</p>",
          "css": ".summary { margin: 0; width: 864px; height: 40px; font: 400 24px Rubik; line-height: 40px; white-space: nowrap; color: #f7f7f8 }",
          "options": {
            "position": "208:408",
            "start": 1.15,
            "motion": {
              "type": "rise",
              "delay": 1.15,
              "duration": 0.55,
              "distance": 14,
              "easing": "$expo"
            }
          }
        },
        {
          "name": "focus_field",
          "type": "html",
          "width": 864,
          "height": 40,
          "html": "<div class=\"field\"><span class=\"chip after\">REVIEW FOCUS</span><span class=\"copy\">{{ reviewFocus }}</span></div>",
          "css": ".field { display: flex; align-items: center; width: 864px; height: 40px; gap: 16px } .chip { display: flex; justify-content: center; align-items: center; height: 36px; padding: 0 14px; border-radius: 6px; font: 400 20px Oswald; letter-spacing: 1px; color: #141416 } .before { background-color: #f96f99 } .after { background-color: #9298fb } .copy { font: 400 20px Rubik; white-space: nowrap; color: #afb0b4 }",
          "options": {
            "position": "208:496",
            "start": 1.55,
            "motion": {
              "type": "rise",
              "delay": 1.55,
              "duration": 0.5,
              "distance": 14,
              "easing": "$expo"
            }
          }
        }
