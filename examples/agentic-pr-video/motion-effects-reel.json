              "preset": "cascade",
              "size": 116,
              "y": 270,
              "delay": 0.15
            },
            {
              "text": {
                "en": "{{ topics }}"
              },
              "preset": "fade",
              "font": "oswald",
              "size": 32,
              "y": 470,
              "color": "$color.muted",
              "delay": "title.end",
              "unit": "line"
            }
          ],
