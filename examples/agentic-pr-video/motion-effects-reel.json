{
  "meta": {
    "name": "Motion effects — PR reel",
    "description": "A review reel for the motion-effects branch: chapter cards in kinetic type intercut with the rendered showcase previews, then the agent tooling shown with its real output.",
    "creativeDirection": "Audience: reviewers of a large pull request who need the whole change in under two minutes. Direction: a keynote-style reel on the leclap theme. Each chapter opens on a numbered card (mono number, Bebas title, Oswald topics, an underline that draws itself) and then plays two to five showcase previews full frame, each labelled by a small top pill naming the feature and its JSON field. Designed transitions carry the cuts: whips into chapters, pushes and swipes inside them, one iris and one zoom-through. The agent-tooling chapter shows real CLI output (a snapshot contact sheet, timeline lines, the diagnose feature count) as graphics and type rather than screenshots. Sound comes from the bundled effect library (auto whooshes on designed transitions, hits on impacts) plus the previews' own audio. Avoid: labels covering the previews' own copy, more than one accent per card, text outside the 5% title-safe area, and any invented metric. Review: every label is readable, every chapter card lands before the cut, the timeline and MCP lines fit inside the frame, and the close holds."
  },
  "global": {
    "orientation": "landscape",
    "platform": "youtube",
    "theme": "leclap",
    "fps": 30,
    "seed": 7,
    "musicEnabled": false,
    "motion": {
      "energy": 1
    },
    "transition": {
      "type": "push-left",
      "duration": 0.4,
      "ease": "$snappy"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0,
      "sfx": "auto",
      "normalize": "loudnorm"
    },
    "sfx": [
      {
        "id": "riser",
        "at": "ch1_card.start + 0.3",
        "volume": 0.4
      },
      {
        "id": "riser",
        "at": "ch2_card.start + 0.3",
        "volume": 0.4
      },
      {
        "id": "riser",
        "at": "ch3_card.start + 0.3",
        "volume": 0.4
      },
