{
  "meta": {
    "name": "Motion polish — PR reel",
    "description": "A review reel for the motion-polish work: every fx primitive and the strokes, one beat each, on stand-in footage and theme cards, between numbered chapter cards.",
    "creativeDirection": "Audience: reviewers who need to see what each primitive looks like in under a minute. Direction: a keynote-style reel on the leclap theme. Four numbered chapters (light, marks, ambient, surfaces and strokes), each followed by one beat per primitive with a mono label naming it and its key field. Every effect is anchored to what it decorates and tuned, never a stock look. The footage is a stand-in: the bundled photographs set in motion. Review: each effect reads at 1280x720 and stays inside its ceiling, labels are legible, chapter cards hold long enough to read."
  },
  "global": {
    "orientation": "landscape",
    "platform": "youtube",
    "theme": "leclap",
    "fps": 30,
    "seed": 11,
    "musicEnabled": false,
    "motion": {
      "energy": 1
    },
    "transition": {
      "type": "push-left",
      "duration": 0.35,
      "ease": "$snappy"
    },
    "audio": {
      "sourceVolume": 0,
      "musicVolume": 0,
      "sfx": "auto",
      "normalize": "loudnorm"
    }
  },
  "partials": [
    {
      "id": "chapter-card",
      "description": "Numbered chapter card: a mono number, a cascading title, a topics line and a drawn underline.",
      "variables": {
        "num": "01",
        "title": "Chapter",
        "topics": "topics",
        "exit": "whip-left"
      },
      "envelope": {
        "in": 1.4,
        "out": 0
      },
      "jobs": ["orient", "bridge"],
      "sections": [
        {
          "name": "card",
          "type": "color_background",
          "role": "bridge",
          "options": {
            "backgroundColor": "$color.bg",
            "duration": 2.4
          },
          "camera": {
            "preset": "push-in",
            "amount": 0.04
          },
          "kinetic": [
            {
              "id": "num",
              "text": {
                "en": "{{ num }}"
              },
              "preset": "fade",
              "font": "mono",
              "size": 34,
              "y": 210,
              "color": "$color.brand"
            },
            {
              "id": "title",
              "text": {
                "en": "{{ title }}"
              },
              "preset": "cascade",
              "size": 116,
              "y": 270,
              "delay": 0.15
            },
            {
              "text": {
                "en": "{{ topics }}"
              },
              "preset": "fade",
              "font": "oswald",
              "size": 32,
              "y": 470,
              "color": "$color.muted",
              "delay": "title.end",
              "unit": "line"
            }
          ],
          "graphics": [
            {
              "type": "underline",
              "at": 0.5,
              "x": 520,
              "y": 440,
              "width": 240,
              "thickness": 4,
              "color": "$color.accent",
              "caps": "round",
              "settle": 0.03,
              "exit": "fade"
            }
          ],
          "sfx": [
            {
              "id": "tick",
              "at": 0.05,
              "volume": 0.6
            }
          ],
          "transition": {
            "type": "{{ exit }}",
            "duration": 0.4
          }
        }
      ]
    }
  ],
