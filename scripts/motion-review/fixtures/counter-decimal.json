{
  "label": "Counter (fr locale, decimals, suffix, on footage)",
  "kind": "kinetic",
  "window": { "at": 0.3, "duration": 0.9 },
  "moments": [0.25, 0.45, 0.66, 0.84, 1.2, 1.5],
  "backgrounds": ["footage"],
  "section": {
    "kinetic": [
      {
        "id": "count",
        "text": { "en": "" },
        "preset": "counter",
        "counter": { "from": 0, "to": 98.6, "decimals": 1, "suffix": " %", "locale": "fr" },
        "delay": "{{at}}",
        "duration": "{{duration}}",
        "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
        "size": 140,
        "y": "center",
        "color": "#FFFFFF",
        "effect": { "shadow": true }
      }
    ]
  }
}
