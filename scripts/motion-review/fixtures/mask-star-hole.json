{
  "label": "Mask: a star-shaped hole turning in a card (path, invert, rotate track)",
  "kind": "mask",
  "window": { "at": 0.3, "duration": 1.2 },
  "section": {
    "inputs": [
      {
        "name": "card",
        "type": "html",
        "html": "<div class=\"card\"></div>",
        "css": ".card { height: {{h}}px; border-radius: 24px; background: #F96F99 }",
        "width": "{{w}}",
        "height": "{{h}}",
        "options": {
          "position": "{{position}}",
          "mask": {
            "shape": {
              "type": "path",
              "d": "M{{cx}} {{cy}} m0 -120 l35 85 l90 5 l-70 60 l25 90 l-80 -50 l-80 50 l25 -90 l-70 -60 l90 -5 z"
            },
            "invert": true,
            "feather": 4,
            "animate": {
              "rotate": [
                { "t": "{{at}}", "v": 0 },
                { "t": "{{end}}", "v": 72, "ease": "ease-in-out-cubic" }
              ]
            }
          }
        }
      }
    ]
  }
}
