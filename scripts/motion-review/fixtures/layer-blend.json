{
  "label": "Layer blend: multiply bands + screen glow",
  "kind": "layer",
  "window": { "at": 0.3, "duration": 1.2 },
  "section": {
    "inputs": [
      {
        "name": "bands",
        "type": "html",
        "html": "<div class=\"b\"><div class=\"d\"></div><div class=\"m\"></div><div class=\"l\"></div></div>",
        "css": ".b { display: flex; width: {{w}}px; height: {{h}}px; } .d { flex: 1; background: #3A2A5C; } .m { flex: 1; background: #9298FB; } .l { flex: 1; background: #FFE9C7; }",
        "width": "{{w}}",
        "height": "{{h}}",
        "options": { "position": "{{position}}", "start": "{{at}}", "blend": "multiply" }
      },
      {
        "name": "glow",
        "type": "html",
        "html": "<div class=\"g\"></div>",
        "css": ".g { width: 240px; height: 240px; border-radius: 120px; background: #FF8AAE; }",
        "width": 240,
        "height": 240,
        "options": {
          "position": "{{position}}",
          "start": "{{at}}",
          "blend": "screen",
          "animate": {
            "x": [
              { "t": "{{at}}", "v": "+0" },
              { "t": "{{end}}", "v": "+240" }
            ]
          }
        }
      }
    ]
  }
}
