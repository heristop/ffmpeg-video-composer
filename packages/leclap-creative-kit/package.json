{
  "name": "@leclap/creative-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private shared LeClap creative catalog: templates, partials, fonts, media, and bundled assets",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./render-quips": {
      "types": "./src/render-quips.ts",
      "default": "./src/render-quips.ts"
    },
    "./partials": {
      "types": "./src/partials.ts",
      "default": "./src/partials.ts"
    },
    "./fonts": {
      "types": "./src/fonts.ts",
      "default": "./src/fonts.ts"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./src/media.ts"
    },
    "./sfx": {
      "types": "./src/sfx.ts",
      "default": "./src/sfx.ts"
    },
    "./music-beats": {
      "types": "./src/music-beats.ts",
      "default": "./src/music-beats.ts"
    },
    "./*.json": {
      "default": "./src/templates/*.json"
    },
    "./templates/*": {
      "default": "./src/templates/*"
    },
    "./library/*": {
      "default": "./src/library/*"
    },
    "./clappy": {
      "types": "./src/clappy.ts",
      "default": "./src/clappy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "gen:templates": "node scripts/gen-templates.ts",
    "gen:partials": "node scripts/gen-partials.ts",
    "gen:sfx": "node scripts/gen-sfx.ts",
    "gen:animation-thumbs": "node scripts/gen-animation-thumbs.ts",
    "gen:music-covers": "node scripts/gen-music-covers.ts",
    "gen:music-beats": "node scripts/analyze-music-library.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "ffmpeg-video-composer": "workspace:*",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
