{
  "description": "LeClap logo sting (portrait): the 2.4 s bumper clip framed by brand-coloured rules, faded in and out.",
  "envelope": { "in": 0.5, "out": 0.5 },
  "syncPoints": [{ "id": "logo", "offset": 0.5 }],
  "jobs": ["brand", "close"],
  "useWhen": "Open or sign off a video with the LeClap identity, ideally with the logo landing on a downbeat.",
  "avoidWhen": "Mid-video: a bumper reads as a beginning or an ending, never as a transition.",
  "sections": [
    {
      "name": "logo_bumper",
      "type": "video",
      "options": {
        "videoUrl": "https://github.com/heristop/leclap/raw/main/src/shared/assets/videos/leclap_bumper_portrait.mp4",
        "duration": 2.4,
        "muteSection": true
      },
      "filters": [
        {
          "type": "drawbox",
          "values": { "x": 0, "y": 0, "w": 720, "h": 10, "c": "#7C83FD@1", "t": "fill" }
        },
        {
          "type": "drawbox",
          "values": { "x": 0, "y": 1270, "w": 720, "h": 10, "c": "#FF8AAE@1", "t": "fill" }
        },
        {
          "type": "fadein",
          "values": { "color": "#0b0b0f" }
        },
        {
          "type": "fadeout",
          "values": { "color": "#0b0b0f" }
        }
      ]
    }
  ]
}
