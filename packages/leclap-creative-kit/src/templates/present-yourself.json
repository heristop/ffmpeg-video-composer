{
  "meta": {
    "name": "Present Yourself",
    "description": "Introduce yourself — a cinematic title card wipes into your graded clip with your name on a lower third, all rendered on this device."
  },
  "global": {
    "orientation": "landscape",
    "musicEnabled": true,
    "music": {
      "name": "party-dance.mp3"
    },
    "allowedMusic": ["party-dance", "chill-hip-hop", "lofi-study", "indie-rock-dreamy", "cafe-jazz"],
    "allowUploadMusic": true,
    "transition": {
      "type": "fade",
      "duration": 0.5
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "normalize": "loudnorm",
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Present yourself"
      },
      "description": {
        "en": ""
      },
      "options": {
        "fields": [
          {
            "name": "form_1_firstname",
            "maxLength": 24,
            "label": {
              "en": "Your first name"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "transition": {
        "type": "push-left",
        "duration": 0.5,
        "ease": "$snappy"
      },
      "titleCard": {
        "kicker": {
          "en": "PRESENTING"
        },
        "headline": {
          "en": "{{ form_1_firstname }}"
        },
        "subtitle": {
          "en": "shot & rendered on this device"
        },
        "accent": "#7C83FD",
        "align": "center",
        "reveal": {
          "type": "slide-left",
          "duration": 0.6
        },
        "effect": {
          "shadow": true
        }
      },
      "options": {
        "backgroundColor": "#0d1b2a",
        "duration": 2.8,
        "layers": [
          {
            "gradient": {
              "from": "#13243f",
              "to": "#0d1b2a",
              "direction": "vertical"
            }
          }
        ]
      },
      "camera": {
        "preset": "push-in",
        "amount": 0.1
      },
      "graphics": [
        {
          "type": "fx",
          "effect": "bokeh",
          "target": "frame",
          "at": 0,
          "duration": 2.8,
          "count": 7,
          "size": 0.13,
          "softness": 0.4,
          "drift": -80,
          "speed": 0.04,
          "depth": 0.7,
          "clear": 0.34,
          "color": "#7C83FD",
          "intensity": 1
        }
      ]
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "teal-orange",
      "title": {
        "en": "Record your clip"
      },
      "description": {
        "en": "Say hi — your moment, graded and signed"
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "musicVolume": 0.04,
        "framingGuide": {
          "type": "silhouette",
          "position": "center"
        },
        "mask": {
          "shape": {
            "type": "ellipse",
            "cx": 640,
            "cy": 340,
            "rx": 960,
            "ry": 640
          },
          "feather": 70,
          "animate": {
            "scale": [
              {
                "t": 0.3,
                "v": 0
              },
              {
                "t": 1.5,
                "v": 1.04,
                "ease": "$smooth"
              }
            ]
          },
          "background": "#0d1b2a"
        }
      },
      "graphics": [
        {
          "type": "fx",
          "effect": "vignette-breathe",
          "target": "frame",
          "at": 0,
          "duration": 6,
          "angle": 0.62,
          "swing": 0.03,
          "period": 6,
          "focus": {
            "x": 0.5,
            "y": 0.4
          },
          "intensity": 1
        },
        {
          "id": "name-glow",
          "type": "fx",
          "effect": "edge-glow",
          "target": {
            "x": 0,
            "y": 576,
            "w": 1280,
            "h": 144
          },
          "at": 0.3,
          "duration": 5.7,
          "line": 0.45,
          "spread": 16,
          "glow": "#7C83FD",
          "breathe": 0.08,
          "period": 4.4,
          "color": "#7C83FD",
          "intensity": 0.7
        }
      ],
      "inputs": [
        {
          "name": "name_card",
          "type": "html",
          "html": "<div class=\"wrap\"><div class=\"plate\"><div class=\"mark\" data-motion=\"mark\"></div><div class=\"txt\"><b data-motion=\"kicker\">ON-DEVICE</b><h2 data-motion=\"name\">{{ form_1_firstname }}</h2></div></div></div>",
          "css": ".wrap { display: flex; align-items: flex-end; width: 100%; height: 100% } .plate { display: flex; border-radius: 0 16px 16px 0; background: rgba(13, 27, 42, 0.84); box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35) } .mark { width: 8px; background: #7C83FD } .txt { display: flex; flex-direction: column; padding: 12px 32px 14px 22px } b { color: #7C83FD; font: 600 18px $font.body; letter-spacing: 4px } h2 { margin: 2px 0 0; color: #ffffff; font: 54px $font.display; line-height: 1.1 }",
          "width": 640,
          "height": 130,
          "options": {
            "position": "0:556",
            "start": 1.5,
            "motion": {
              "type": "fade",
              "delay": 1.5,
              "duration": 0.3,
              "easing": "ease-out"
            }
          },
          "motion": {
            "mark": {
              "opacity": [
                {
                  "t": 0,
                  "v": 0
                },
                {
                  "t": 0.2,
                  "v": 1
                }
              ],
              "x": [
                {
                  "t": 0,
                  "v": -12
                },
                {
                  "t": 0.44,
                  "v": 0,
                  "ease": "$snappy"
                }
              ]
            },
            "kicker": {
              "opacity": [
                {
                  "t": 0.14,
                  "v": 0
                },
                {
                  "t": 0.4,
                  "v": 1
                }
              ]
            },
            "name": {
              "opacity": [
                {
                  "t": 0.2,
                  "v": 0
                },
                {
                  "t": 0.5,
                  "v": 1
                }
              ],
              "y": [
                {
                  "t": 0.2,
                  "v": 14
                },
                {
                  "t": 0.66,
                  "v": 0,
                  "ease": "$smooth"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "type": "partial",
      "ref": "logo-bumper"
    }
  ],
  "formats": {
    "portrait": {
      "sections": {
        "intro": {
          "camera": {
            "amount": 0.12
          },
          "titleCard": {
            "headlineStyle": {
              "fontsize": 76
            }
          }
        },
        "video_1": {
          "graphics": {
            "byId": {
              "name-glow": {
                "target": {
                  "x": 0,
                  "y": 1024,
                  "w": 720,
                  "h": 256
                }
              }
            }
          },
          "options": {
            "mask": {
              "shape": {
                "cx": 360,
                "cy": 600,
                "rx": 620,
                "ry": 1000
              }
            }
          },
          "inputs": [
            {
              "name": "name_card",
              "type": "html",
              "html": "<div class=\"wrap\"><div class=\"plate\"><div class=\"mark\" data-motion=\"mark\"></div><div class=\"txt\"><b data-motion=\"kicker\">ON-DEVICE</b><h2 data-motion=\"name\">{{ form_1_firstname }}</h2></div></div></div>",
              "css": ".wrap { display: flex; align-items: flex-end; width: 100%; height: 100% } .plate { display: flex; border-radius: 0 16px 16px 0; background: rgba(13, 27, 42, 0.84); box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35) } .mark { width: 8px; background: #7C83FD } .txt { display: flex; flex-direction: column; padding: 12px 32px 14px 22px } b { color: #7C83FD; font: 600 18px $font.body; letter-spacing: 4px } h2 { margin: 2px 0 0; color: #ffffff; font: 54px $font.display; line-height: 1.1 }",
              "width": 600,
              "height": 130,
              "options": {
                "position": "0:1090",
                "start": 1.5,
                "motion": {
                  "type": "fade",
                  "delay": 1.5,
                  "duration": 0.3,
                  "easing": "ease-out"
                }
              },
              "motion": {
                "mark": {
                  "opacity": [
                    {
                      "t": 0,
                      "v": 0
                    },
                    {
                      "t": 0.2,
                      "v": 1
                    }
                  ],
                  "x": [
                    {
                      "t": 0,
                      "v": -12
                    },
                    {
                      "t": 0.44,
                      "v": 0,
                      "ease": "$snappy"
                    }
                  ]
                },
                "kicker": {
                  "opacity": [
                    {
                      "t": 0.14,
                      "v": 0
                    },
                    {
                      "t": 0.4,
                      "v": 1
                    }
                  ]
                },
                "name": {
                  "opacity": [
                    {
                      "t": 0.2,
                      "v": 0
                    },
                    {
                      "t": 0.5,
                      "v": 1
                    }
                  ],
                  "y": [
                    {
                      "t": 0.2,
                      "v": 14
                    },
                    {
                      "t": 0.66,
                      "v": 0,
                      "ease": "$smooth"
                    }
                  ]
                }
              }
            }
          ]
        },
        "logo_bumper": {
          "options": {
            "videoUrl": "https://github.com/heristop/leclap/raw/main/src/shared/assets/videos/leclap_bumper_portrait.mp4"
          },
          "filters": [
            {
              "type": "drawbox",
              "values": {
                "x": 0,
                "y": 0,
                "w": 720,
                "h": 10,
                "c": "#7C83FD@1",
                "t": "fill"
              }
            },
            {
              "type": "drawbox",
              "values": {
                "x": 0,
                "y": 1270,
                "w": 720,
                "h": 10,
                "c": "#FF8AAE@1",
                "t": "fill"
              }
            },
            {
              "type": "fadein",
              "values": {
                "color": "#0b0b0f"
              }
            },
            {
              "type": "fadeout",
              "values": {
                "color": "#0b0b0f"
              }
            }
          ]
        }
      }
    }
  }
}
