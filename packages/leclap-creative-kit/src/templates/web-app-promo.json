    {
      "name": "video_1",
      "type": "project_video",
      "title": {
        "en": "Show your app"
      },
      "description": {
        "en": "Upload a landscape screen recording. A shallow perspective reveal settles into a readable screen, with a subtle forward drift and a caption outside the capture."
      },
      "options": {
        "duration": 6.4,
        "forceAspectRatio": false,
        "countdown": true,
        "countdownDuration": 2,
        "forceOriginalAspectRatio": false,
        "captureMode": "screen",
        "allowedCaptureModes": ["screen", "upload"]
      },
      "filters": [
        {
          "type": "fps",
          "value": "30"
        },
        {
          "type": "setsar",
          "value": "1"
        },
        {
          "type": "scale",
          "value": "1120:558:force_original_aspect_ratio=decrease:force_divisible_by=2"
        },
        {
          "type": "pad",
          "value": "1120:558:(ow-iw)/2:(oh-ih)/2:color=0x10141e"
        },
        {
          "type": "pad",
          "value": "1280:720:80:60:color=0x10141e"
        },
        {
          "type": "perspective",
          "value": "x0='W*0.025*pow(1-min(in/42,1),3)':y0='H*0.095*pow(1-min(in/42,1),3)':x1='W*(1-0.025*pow(1-min(in/42,1),3))':y1='H*(-0.025*pow(1-min(in/42,1),3))':x2='W*(-0.01*pow(1-min(in/42,1),3))':y2='H*(1+0.025*pow(1-min(in/42,1),3))':x3='W*(1+0.01*pow(1-min(in/42,1),3))':y3='H*(1-0.095*pow(1-min(in/42,1),3))':sense=destination:eval=frame:interpolation=linear"
        },
        {
          "type": "zoompan",
          "value": "z='1+0.025*(1-pow(1-min(max(on-48,0)/144,1),3))':x='iw/2-iw/zoom/2':y='ih/2-ih/zoom/2':d=1:s=1280x720:fps=30"
        },
        {
          "type": "setsar",
          "value": "1"
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_feature }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 28,
            "fontcolor": "#ffffff",
            "x": 80,
            "y": 22
          },
          "reveal": {
            "type": "rise",
            "delay": 0.28,
            "duration": 0.35,
            "distance": 18,
            "easing": "ease-out"
          }
        },
