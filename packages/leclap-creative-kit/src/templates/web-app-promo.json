            "text": {
              "en": "{{ form_1_promise }}"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 76,
            "fontcolor": "#ffffff",
            "x": 80,
            "y": 272
          },
          "reveal": {
            "type": "rise",
            "delay": 0.04,
            "duration": 0.58,
            "distance": 96,
            "easing": "ease-out"
          },
          "exit": {
            "type": "slide-left",
            "after": 1.88,
            "duration": 0.25,
            "distance": 32,
            "easing": "ease-in-out"
