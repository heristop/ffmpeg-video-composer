{
  "meta": {
    "name": "Product Launch",
    "description": "A minimal vertical reveal: large centred product typography, a clean full-frame shot, and an offer-led closing with fast, staggered motion.",
    "creativeDirection": "Audience: shoppers seeing one product for the first time. Direction: a minimal vertical reveal with the product as the hero, rather than a miniature web-app presentation. Use near-black surfaces, large centered condensed type and a clean full-frame product shot. Move quickly into the footage; make the closing offer and approved price easy to scan. Use one low-opacity specular sheen on the product reveal and let the price count up and settle exactly on the approved value; use staggered entrances sparingly and leave a readable hold. Avoid dense feature lists, fake discounts, covering the product and screen-recording chrome. Review product crop, longest name and price, type settling and the closing invitation. Motion: push up from the intro into the product, a slow specular sheen crosses the shot as it lands, then a dark gradient seal turns upright behind the price as it counts up and settles, a round-capped rule draws under it, and the offer card staggers in beneath on a slow push-in."
  },
  "global": {
    "orientation": "portrait",
    "variables": {
      "brand": "YOUR BRAND"
    },
    "musicEnabled": true,
    "music": {
      "name": "lofi-study.mp3"
    },
    "allowedMusic": ["lofi-study", "chill-hip-hop", "the-builder", "indie-rock-dreamy", "once-in-paris"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    },
    "theme": {
      "colors": {
        "bg": "#090909",
        "fg": "#ffffff",
        "surface": "#1a1814",
        "brand": "#c8bc9c",
        "accent": "#e7a23b"
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your product"
      },
      "description": {
        "en": "The name and one-line pitch over your clip, with your offer on the closing card"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_name",
            "maxLength": 13,
            "label": {
              "en": "Product name"
            }
          },
          {
            "name": "form_1_tagline",
            "maxLength": 24,
            "label": {
              "en": "One-line pitch"
            }
          },
          {
            "name": "form_1_price",
            "maxLength": 12,
            "label": {
              "en": "Price or offer"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#090909",
        "duration": 2.1,
        "layers": [
          {
            "color": "#c8bc9c",
            "x": 290,
            "y": 475,
            "w": 140,
            "h": 3
          }
        ]
      },
      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "INTRODUCING"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 32,
            "fontcolor": "#c8bc9c",
            "x": "(w-text_w)/2",
            "y": 385
          },
          "reveal": {
            "type": "fade",
            "delay": 0,
            "duration": 0.2,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_name }}"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 88,
            "fontcolor": "#ffffff",
            "x": "(w-text_w)/2",
            "y": 535
          },
          "reveal": {
            "type": "rise",
            "delay": 0.06,
            "duration": 0.32,
            "easing": "ease-out",
            "distance": 42
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_tagline }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 32,
            "fontcolor": "#c8bc9c",
            "x": "(w-text_w)/2",
            "y": 685
          },
          "reveal": {
            "type": "rise",
            "delay": 0.14,
            "duration": 0.26,
            "easing": "ease-out",
            "distance": 20
          }
        }
      ],
      "transition": {
        "type": "push-up",
        "duration": 0.45,
        "ease": "$smooth"
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "vivid-pop",
      "title": {
        "en": "Show your product"
      },
      "description": {
        "en": "Record or upload a product shot. The product name appears along the bottom; the offer appears on the closing card."
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2
      },
      "filters": [
        {
          "type": "vignette"
        }
      ],
      "caption": {
        "text": {
          "en": "{{ form_1_name }}"
        },
        "style": "subtle",
        "position": "bottom",
        "align": "center",
        "font": "bebas",
        "fontsize": 60,
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.28,
          "easing": "ease-out",
          "distance": 28
        },
        "effect": {
          "shadow": true
        },
        "box": true,
        "boxColor": "#090909",
        "boxOpacity": 0.65
      },
      "graphics": [
        {
          "type": "fx",
          "effect": "sheen",
          "target": "frame",
          "at": 0.4,
          "duration": 1.2,
          "profile": "specular",
          "width": 0.2,
          "bloom": 0.35,
          "tilt": 24,
          "direction": "down",
          "ease": "cubic-bezier(0.3, 0, 0.3, 1)",
          "intensity": 0.6,
          "color": "$color.fg"
        }
      ]
    },
    {
      "name": "outro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#090909",
        "duration": 2.1
      },
      "filters": [],
      "graphics": [
        {
          "type": "shape",
          "at": 0.05,
          "preset": {
            "type": "star",
            "points": 14,
            "inner": 0.88
          },
          "x": 130,
          "y": 420,
          "width": 460,
          "height": 460,
          "gradient": {
            "from": "$color.surface",
            "to": "$color.bg",
            "angle": 150
          },
          "stroke": {
            "color": "$color.accent",
            "width": 4
          },
          "animate": {
            "scale": [
              {
                "t": 0.05,
                "v": 0.55
              },
              {
                "t": 0.75,
                "v": 1,
                "ease": "spring(260, 16)"
              }
            ],
            "rotate": [
              {
                "t": 0.05,
                "v": -24
              },
              {
                "t": 0.9,
                "v": 0,
                "ease": "$smooth"
              }
            ],
            "opacity": [
              {
                "t": 0.05,
                "v": 0
              },
              {
                "t": 0.3,
                "v": 1
              }
            ]
          },
          "ease": "$smooth"
        },
        {
          "type": "underline",
          "x": 230,
          "y": 706,
          "width": 260,
          "thickness": 6,
          "origin": "center",
          "at": 0.7,
          "color": "$color.brand",
          "caps": "round",
          "settle": 0.03,
          "exit": "none"
        }
      ],
      "camera": {
        "preset": "push-in",
        "amount": 0.08
      },
      "kinetic": [
        {
          "id": "price",
          "text": {
            "en": "{{ form_1_price }}"
          },
          "preset": "counter",
          "counter": {
            "from": 0
          },
          "delay": 0.08,
          "duration": 0.8,
          "ease": "$expo",
          "font": "BebasNeue.ttf",
          "size": 88,
          "color": "#c8bc9c",
          "y": 598
        }
      ],
      "inputs": [
        {
          "name": "offer_card",
          "type": "html",
          "html": "<div><b data-motion=\"tag\">THE OFFER</b><p data-motion=\"plate\"><span>{{ form_1_name }}</span>{{ form_1_tagline }}</p><em data-motion=\"cta\">MAKE IT YOURS</em></div>",
          "css": "div{display:flex;flex-direction:column;align-items:center;color:$color.brand;font:300 26px $font.body}b{padding:8px 20px;border:2px solid $color.brand;border-radius:8px 99px 99px 8px;font:500 22px $font.body;letter-spacing:4px}p{display:flex;align-items:center;margin:522px 0 0;padding:14px 24px;border:1px solid $color.brand@0.35;border-radius:14px;background:$color.surface}span{margin-right:16px;color:$color.fg;font:48px $font.display}em{margin-top:62px;padding:12px 34px;border-radius:99px;background:$color.brand;color:$color.bg;font:600 28px $font.body;letter-spacing:3px}",
          "width": 720,
          "height": 790,
          "options": {
            "position": "0:352",
            "start": 0.14
          },
          "motion": {
            "tag": {
              "opacity": [
                {
                  "t": 0,
                  "v": 0
                },
                {
                  "t": 0.24,
                  "v": 1
                }
              ],
              "y": [
                {
                  "t": 0,
                  "v": -14
                },
                {
                  "t": 0.4,
                  "v": 0,
                  "ease": "$smooth"
                }
              ]
            },
            "plate": {
              "opacity": [
                {
                  "t": 0.7,
                  "v": 0
                },
                {
                  "t": 0.98,
                  "v": 1
                }
              ],
              "y": [
                {
                  "t": 0.7,
                  "v": 22
                },
                {
                  "t": 1.18,
                  "v": 0,
                  "ease": "$smooth"
                }
              ]
            },
            "cta": {
              "opacity": [
                {
                  "t": 0.9,
                  "v": 0
                },
                {
                  "t": 1.14,
                  "v": 1
                }
              ],
              "y": [
                {
                  "t": 0.9,
                  "v": 22
                },
                {
                  "t": 1.34,
                  "v": 0,
                  "ease": "$smooth"
                }
              ],
              "scale": [
                {
                  "t": 0.9,
                  "v": 0.94
                },
                {
                  "t": 1.34,
                  "v": 1,
                  "ease": "$snappy"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
