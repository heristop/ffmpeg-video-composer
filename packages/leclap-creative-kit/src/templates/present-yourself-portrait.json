{
  "meta": {
    "name": "Present Yourself (Portrait)",
    "description": "Introduce yourself — a cinematic title card wipes into your graded clip with your name on a lower third, all rendered on this device."
  },
  "global": {
    "orientation": "portrait",
    "musicEnabled": true,
    "music": {
      "name": "party-dance.mp3"
    },
    "allowedMusic": ["party-dance", "chill-hip-hop", "lofi-study", "indie-rock-dreamy", "cafe-jazz"],
    "allowUploadMusic": true,
    "transition": {
      "type": "fade",
      "duration": 0.5
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "normalize": "loudnorm",
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Present yourself"
      },
      "description": {
        "en": ""
      },
      "options": {
        "fields": [
          {
            "name": "form_1_firstname",
            "maxLength": 24,
            "label": {
              "en": "Your first name"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "transition": {
        "type": "push-left",
        "duration": 0.5,
        "ease": "$snappy"
      },
      "titleCard": {
        "kicker": {
          "en": "PRESENTING"
        },
        "headline": {
          "en": "{{ form_1_firstname }}"
        },
        "subtitle": {
          "en": "shot & rendered on this device"
        },
        "accent": "#7C83FD",
        "align": "center",
        "reveal": {
          "type": "slide-left",
          "duration": 0.6
        },
        "effect": {
          "shadow": true
        },
        "headlineStyle": {
          "fontsize": 76
        }
      },
      "options": {
        "backgroundColor": "#0d1b2a",
        "duration": 2.8,
        "layers": [
          {
            "gradient": {
              "from": "#13243f",
              "to": "#0d1b2a",
              "direction": "vertical"
            }
          }
        ]
      },
      "camera": {
        "preset": "push-in",
        "amount": 0.12
      },
      "graphics": [
        {
          "type": "fx",
          "effect": "bokeh",
          "target": "frame",
          "at": 0,
          "duration": 2.8,
          "count": 7,
          "size": 0.13,
          "softness": 0.4,
          "drift": -80,
          "speed": 0.04,
          "depth": 0.7,
          "clear": 0.34,
          "color": "#7C83FD",
          "intensity": 1
        }
      ]
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "teal-orange",
      "title": {
        "en": "Record your clip"
      },
      "description": {
        "en": "Say hi — your moment, graded and signed"
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "musicVolume": 0.04,
        "framingGuide": {
          "type": "silhouette",
          "position": "center"
        }
      },
      "lowerThird": {
        "title": {
          "en": "{{ form_1_firstname }}"
        },
        "badge": {
          "en": "ON-DEVICE"
        },
        "accent": "#7C83FD",
        "reveal": "rise",
        "effect": {
          "shadow": true
        }
      },
      "graphics": [
        {
          "type": "fx",
          "effect": "vignette-breathe",
          "target": "frame",
          "at": 0,
          "duration": 6,
          "angle": 0.62,
          "swing": 0.03,
          "period": 6,
          "focus": {
            "x": 0.5,
            "y": 0.4
          },
          "intensity": 1
        },
        {
          "type": "fx",
          "effect": "edge-glow",
          "target": {
            "x": 0,
            "y": 1024,
            "w": 720,
            "h": 256
          },
          "at": 0.3,
          "duration": 5.7,
          "line": 0.45,
          "spread": 16,
          "glow": "#7C83FD",
          "breathe": 0.08,
          "period": 4.4,
          "color": "#7C83FD",
          "intensity": 0.7
        }
      ]
    },
    {
      "type": "partial",
      "ref": "logo-bumper-portrait"
    }
  ]
}
