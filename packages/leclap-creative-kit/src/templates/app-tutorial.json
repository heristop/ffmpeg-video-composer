{
  "meta": {
    "name": "App Tutorial",
    "description": "A screen-first square lesson with numbered steps, calm mint typography and a letterboxed walkthrough.",
    "creativeDirection": "Audience: a new user learning one interaction. Direction: calm, screen-first instruction in a square frame. Use pale mint surfaces and numbered steps; let the walkthrough carry the explanation. Keep caption hierarchy subordinate to the interface and preserve the recorded cursor and controls within the letterboxed screen. Stagger the numbered instruction with short, restrained directional entrances and enough time to understand each action. Avoid promotional camera moves, bouncing labels, tiny interface details and decorative interruptions. Review the step number, interaction visibility, caption placement, longest copy and final instruction."
  },
  "global": {
    "orientation": "square",
    "musicEnabled": true,
    "music": {
      "name": "the-builder.mp3"
    },
    "allowedMusic": ["the-builder", "lofi-hip-hop", "point-being", "upbeat-electronic", "lofi-chill"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.28,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
