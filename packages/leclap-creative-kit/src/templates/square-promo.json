{
  "meta": {
    "name": "Square Promo",
    "description": "A bold editorial square campaign: contrasting panels, staggered lateral typography, a full-bleed product clip and a graphic closing invitation.",
    "creativeDirection": "Audience: people scanning a square social campaign. Direction: a graphic editorial invitation, with contrasting lime and dark panels, staggered lateral typography and a full-bleed product clip. Alternate the dominant element between headline, footage and invitation; keep one focal point per scene. Use one brief light pass on the footage and opposing overshoot motion to make transitions punchy, with a settled hold before the next cut. Avoid reproducing the tutorial layout, identical cards, excess subheadings and text over the product focal point. Review the opening hierarchy, clip crop, text bounds and final invitation at feed size."
  },
  "global": {
    "orientation": "square",
    "variables": {
      "brand": "YOUR LOGO"
    },
    "musicEnabled": true,
    "music": {
      "name": "upbeat-electronic.mp3"
    },
    "allowedMusic": ["upbeat-electronic", "future-bass-energy", "party-dance", "lofi-hip-hop", "indie-rock-dreamy"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    },
    "overlays": [
      {
        "text": {
          "en": "{{ brand }}"
        },
        "position": "top-right",
        "color": "#ffffff",
        "size": 32,
        "effect": {
          "shadow": true
        },
        "reveal": {
          "type": "fade",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "sections": ["video_1"]
      }
    ]
  },
