{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true
  },
  "include": ["./**/*.ts"]
}
