# README/npm artwork, served straight from raw.githubusercontent.com — it has to be the real bytes in
# the repo, not an LFS pointer. This repo's LFS budget is exhausted (see .github/workflows/ci.yml),
# so raw.githubusercontent.com would hand GitHub's camo proxy and npm the 131-byte pointer file as
# text/plain and both would render a broken image. Kept binary (-text) so no eol conversion runs.
.github/media/** -filter -diff -merge -text

# The landing's films and clips, served by the site. New LFS objects can't reach GitHub while the budget is
# exhausted (a pointer would fail the push's GH008 check), so these are plain blobs — like the README
# artwork. Kept binary (-text) so no eol conversion runs.
apps/leclap-web/public/videos/films/** -filter -diff -merge -text
apps/leclap-web/public/videos/home/** -filter -diff -merge -text

# Small, reproducible showcase previews use plain blobs like the existing landing films.
apps/leclap-web/public/videos/showcase/*.mp4 -filter -diff -merge -text
apps/leclap-web/public/videos/showcase/*.webp -filter -diff -merge -text

# Authored app-demo capture used to reproduce the showcase promo.
examples/showcase/media/*.mp4 -filter -diff -merge -text
